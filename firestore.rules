rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // Teste si le viewer courant est ami du user ownerUid.
    // Utilisé pour contrôler l'accès aux wishlists privées d'un ami.
    function isFriendOf(ownerUid) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/users/$(ownerUid)).data.get('friends', []);
    }

    // ── users ──────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);
      // FIX #1: acceptRequest fait un arrayUnion dans le doc d'un AUTRE utilisateur.
      // On autorise l'update du seul champ 'friends' par n'importe quel user connecté.
      allow update: if isOwner(userId) ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']));

      match /onboarding/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /favorites/{favoriteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['name', 'createdAt']);
        allow update, delete: if isOwner(userId);
      }
      match /wishlists/{wishlistId} {
        // Lecture : propriétaire + tout user authé (filtrage isPublic côté service getVisibleWishlists)
        allow read: if isAuth();
        allow write: if isOwner(userId);
        match /products/{productId} {
          // FIX : lecture autorisée pour le propriétaire, les amis, ou si la wishlist est publique.
          // La sécurisation principale est dans getVisibleWishlists (côté service).
          // On autorise isAuth() pour éviter le bug où un ami voit la wishlist
          // mais ne peut pas charger ses produits (Firestore rejetait la query).
          allow read: if isOwner(userId) ||
            (isAuth() && get(/databases/$(database)/documents/users/$(userId)/wishlists/$(wishlistId)).data.isPublic == true) ||
            (isAuth() && isFriendOf(userId));
          allow write: if isOwner(userId);
        }
      }
      match /people/{personId} {
        allow read, write: if isOwner(userId);
        match /giftLists/{listId} {
          allow read, write: if isOwner(userId);
        }
      }
      // FIX #3: profiles subcollection was missing from rules
      match /profiles/{profileId} {
        allow read, write: if isOwner(userId);
      }
      match /giftProfiles/{profileId} {
        allow read, write: if isOwner(userId);
      }
      match /homeFeeds/{feedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── gifts / products ────────────────────────────────────────────────────

    match /gifts/{giftId} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /products/{productId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Favourites (legacy FlutterFlow) ─────────────────────────────────────

    match /Favourites/{docId} {
      allow read, create, update, delete: if isAuth();
    }
    match /favourites/{docId} {
      allow read, create, update, delete: if isAuth();
    }

    // ── chats & messages ────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      // FIX: allow update for new members being added (joinByToken / addMember)
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // FIX #7: system messages have senderId == 'system', relax the sender check
        allow create: if isAuth()
                   && isChatParticipant(chatId)
                   && (request.resource.data.senderId == request.auth.uid
                       || request.resource.data.get('type', '') == 'system');
        allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── wishlists (root collection) ─────────────────────────────────────────

    match /wishlists/{wishlistId} {
      allow read, write: if isAuth() && resource != null && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAuth() && resource.data.isPublic == true;

      match /products/{productId} {
        allow read: if isAuth();
        allow write: if isAuth() &&
          get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.ownerUid == request.auth.uid;
      }
    }

    // ── friend_requests ─────────────────────────────────────────────────────

    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      // FIX: both sender and receiver can update (sender can cancel)
      allow update: if isAuth() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ── handles ─────────────────────────────────────────────────────────────

    match /handles/{handle} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── collaborations ──────────────────────────────────────────────────────

    match /collaborations/{collabId} {
      // FIX #5 : allow read by any auth user so inviteToken query works as fallback.
      // collab_tokens est maintenant l'index principal (plus sûr).
      // Les données ne sont pas sensibles (pas de données perso).
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      // L'hôte peut tout modifier (retainedGift, collection, payment, mode…).
      // Un membre / invité ne peut modifier QUE members et pendingInvites
      // (join par token / addMember / decline / sync cadeaux) — pas les champs cagnotte.
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        (
          (request.auth.uid in resource.data.members ||
           request.auth.uid in resource.data.get('pendingInvites', [])) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['members', 'pendingInvites', 'gifts'])
        )
      );
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;

      // ── participants (cagnotte : statut de paiement) ──────────────────────
      // Money-sensitive : verrouillé finement.
      //   - Lecture : hôte ou membre de la collab.
      //   - Écriture générale (créer les parts, confirmer, refuser) : hôte only.
      //   - Un participant peut UNIQUEMENT passer SON propre statut à 'declared'
      //     (« j'ai envoyé »), sans toucher à son montant.
      match /participants/{participantUid} {
        function collab() {
          return get(/databases/$(database)/documents/collaborations/$(collabId)).data;
        }
        function isHost() {
          return isAuth() && collab().ownerId == request.auth.uid;
        }
        function isCollabMember() {
          return isAuth() && (
            collab().ownerId == request.auth.uid ||
            request.auth.uid in collab().members
          );
        }
        // Cagnotte ouverte : tout le monde donne le montant de son choix
        // (pas de tarif imposé par l'hôte) — voir GroupGiftService.startCollection.
        function isOpenPot() {
          return collab().get('collection', {}).get('splitType', '') == 'open';
        }
        allow read: if isCollabMember();
        // En cagnotte ouverte, un membre peut créer SON propre document de
        // contribution (l'hôte ne connaît pas le montant à l'avance).
        allow create: if isHost() || (
          isCollabMember() &&
          participantUid == request.auth.uid &&
          isOpenPot()
        );
        allow update: if isHost() || (
          participantUid == request.auth.uid &&
          (
            // Mode normal : le participant déclare avoir payé, sans toucher
            // au montant fixé par l'hôte.
            (request.resource.data.status == 'declared' &&
             request.resource.data.share == resource.data.share) ||
            // Cagnotte ouverte : le participant peut ajuster librement le
            // montant qu'il souhaite donner.
            (isOpenPot() && request.resource.data.status == 'declared')
          )
        );
        allow delete: if isHost();
      }
    }

    // ── collab_tokens ─────────────────────────────────────────────────────────
    // Index des tokens d'invitation. Lecture libre (isAuth) car les données
    // ne contiennent que collabId, chatId, profileName — pas de données perso.
    match /collab_tokens/{token} {
      allow read: if isAuth();
      // Seul l'owner de la collab peut créer le token (via createOrGetCollab)
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuth() && resource.data.ownerId == request.auth.uid;
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── collab_invites ──────────────────────────────────────────────────────

    match /collab_invites/{inviteId} {
      allow read: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
      allow delete: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ── notifications ─────────────────────────────────────────────────────────

    match /notifications/{targetUid} {
      match /items/{itemId} {
        allow read: if isOwner(targetUid);
        // Tout user authé peut envoyer une notification à quelqu'un d'autre
        allow create: if isAuth();
        allow update, delete: if isOwner(targetUid);
      }
    }

    // ── secret_santa_groups ─────────────────────────────────────────────────
    // Sécurité : chaque participant ne peut lire QUE sa propre paire (pairs/{uid})

    match /secret_santa_groups/{groupId} {
      allow read: if isAuth() &&
        (resource.data.createdBy == request.auth.uid ||
         request.auth.uid in resource.data.participantUids);
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAuth() && (
        resource.data.createdBy == request.auth.uid ||
        request.auth.uid in resource.data.participantUids
      );
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;

      match /participants/{uid} {
        allow read: if isAuth() && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/secret_santa_groups/$(groupId)).data.participantUids.hasAny([request.auth.uid])
        );
        allow write: if isAuth() && (
          uid == request.auth.uid ||
          get(/databases/$(database)/documents/secret_santa_groups/$(groupId)).data.createdBy == request.auth.uid
        );
      }

      match /pairs/{uid} {
        // SEUL le bénéficiaire (le giver) peut lire sa propre paire.
        // Personne d'autre — même l'organisateur — ne peut voir les autres paires.
        allow read: if isAuth() && request.auth.uid == uid;
        // L'organisateur (createdBy) peut écrire les paires pendant le tirage
        allow write: if isAuth() &&
          get(/databases/$(database)/documents/secret_santa_groups/$(groupId)).data.createdBy == request.auth.uid;
      }
    }

    // ── ss_tokens (index tokens pour join-by-code) ──────────────────────────
    match /ss_tokens/{token} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isAuth() && resource.data.createdBy == request.auth.uid;
    }

    // ── fallback ─────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
