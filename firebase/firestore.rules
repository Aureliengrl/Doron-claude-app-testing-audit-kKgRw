rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────────────────
    // FONCTIONS UTILITAIRES
    // ─────────────────────────────────────────────────────────────────────────

    /// Vérifie que l'utilisateur est connecté (non anonyme)
    function isAuth() {
      return request.auth != null;
    }

    /// Vérifie que l'utilisateur accède à ses propres données
    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    /// Vérifie qu'aucun champ critique n'est modifié
    function notChanging(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: users
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Un utilisateur connecté peut lire les profils (pour la recherche d'amis)
      allow read: if isAuth();
      allow write: if isOwner(userId);

      // Onboarding answers
      match /onboarding/{docId} {
        allow read, write: if isOwner(userId);
      }

      // Favoris
      match /favorites/{favoriteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasAll(['name', 'createdAt']);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }

      // Listes de souhaits
      match /wishlists/{wishlistId} {
        allow read, write: if isOwner(userId);

        // Produits dans la wishlist (sous-collection directe)
        match /products/{productId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Destinataires (people)
      match /people/{personId} {
        allow read, write: if isOwner(userId);

        // Listes de cadeaux par destinataire
        match /giftLists/{listId} {
          allow read, write: if isOwner(userId);
        }
      }

      // Profils enrichis (gift profiles)
      match /giftProfiles/{profileId} {
        allow read, write: if isOwner(userId);
      }

      // Historique feeds
      match /homeFeeds/{feedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: gifts (catalogue produits — lecture seule pour tous les auth)
    // ─────────────────────────────────────────────────────────────────────────

    match /gifts/{giftId} {
      // Lecture seule pour tout utilisateur authentifié
      allow read: if isAuth();
      // Écriture admin uniquement (via Cloud Functions ou console Firebase)
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: products (alias gifts — même règles)
    // ─────────────────────────────────────────────────────────────────────────

    match /products/{productId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: favourites (ancien schéma FlutterFlow — lecture/écriture user)
    // ─────────────────────────────────────────────────────────────────────────

    match /favourites/{docId} {
      allow read: if isAuth() && resource.data.uid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: chats & messages (collaborative lists)
    // ─────────────────────────────────────────────────────────────────────────

    match /chats/{chatId} {
      // Un utilisateur peut lire/modifier un chat s'il fait partie des participants
      allow read, update: if isAuth() && request.auth.uid in resource.data.participants;
      // Tout utilisateur connecté peut créer un chat s'il s'inclut dans les participants
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      allow delete: if false;

      match /messages/{messageId} {
        // Pour lire ou écrire un message, l'utilisateur doit faire partie des participants du chat parent
        allow read: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuth() 
                   && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants
                   && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: friend_requests
    // ─────────────────────────────────────────────────────────────────────────

    match /friend_requests/{requestId} {
      // Tout utilisateur connecté peut lire — indispensable pour les collection
      // queries (.where('toUid', isEqualTo: uid).snapshots()).
      // Les règles per-document (resource.data.*) bloquent silencieusement les
      // listeners de collection. Le filtrage toUid/fromUid est dans la query.
      allow read: if isAuth();
      // Seul l'expéditeur peut créer (son uid doit être dans fromUid)
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      // Destinataire (accept/decline) OU expéditeur (annulation) peuvent modifier
      allow update: if isAuth() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      // Expéditeur ou destinataire peuvent supprimer
      allow delete: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // COLLECTION: handles (index pseudo → uid, pour l'unicité)
    // ─────────────────────────────────────────────────────────────────────────

    match /handles/{handle} {
      // Tout utilisateur connecté peut vérifier si un handle est dispo
      allow read: if isAuth();
      // Seul l'utilisateur dont l'uid correspond peut créer/modifier son handle
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuth() && resource.data.uid == request.auth.uid;
      allow delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // FALLBACK — Tout le reste est refusé
    // ─────────────────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
