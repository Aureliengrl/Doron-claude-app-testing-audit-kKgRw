# ─── Anthropic (OBLIGATOIRE) ──────────────────────────────────────────────────
# Créer sur : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-METS-TA-CLE-ICI

# ─── OpenAI (pour ai_db_retagger.js) ─────────────────────────────────────────
OPENAI_API_KEY=sk-METS-TA-CLE-ICI

# ─── Google Custom Search (OPTIONNEL) ─────────────────────────────────────────
# 100 requêtes/jour gratuites, puis 5$/1000 requêtes
#
# 1. Créer une clé API : https://console.developers.google.com/
#    → Activer "Custom Search API"
#    → Credentials → Create API Key
#
# 2. Créer un moteur de recherche : https://programmablesearchengine.google.com/
#    → Nouveau moteur → "Whole web" → Récupérer le CX ID
#
GOOGLE_CSE_KEY=AIzaSy-METS-TA-CLE-ICI
GOOGLE_CSE_ID=12345678901234567:abc123

# ─── Amazon Associates (PLUS TARD — pour la monétisation) ────────────────────
# Créer sur : https://affiliate-program.amazon.fr
# Demande l'accès PA API une fois le compte approuvé
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_ASSOCIATE_TAG=doron-21      # Ton tag affilié (ex: doron-21)
AMAZON_REGION=eu-west-1            # Pour amazon.fr

# ─── Awin (PLUS TARD — pour la monétisation) ─────────────────────────────────
# Créer sur : https://www.awin.com
AWIN_API_TOKEN=
AWIN_PUBLISHER_ID=

# ─── RapidAPI (pour import_products_rapidapi.js) ──────────────────────────────
# Créer sur : https://rapidapi.com/hub — s'abonner à une API de type
# "Real-Time Product Search" (agrégateur Google Shopping, large couverture
# marques). Copier la clé depuis l'onglet "Endpoints" > "Code Snippets".
RAPIDAPI_KEY=
RAPIDAPI_HOST=real-time-product-search.p.rapidapi.com
