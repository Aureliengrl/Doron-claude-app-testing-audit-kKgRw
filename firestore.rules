rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isChatParticipant(chatId) {
      return isAuth() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
    }

    // ── users ──────────────────────────────────────────────────────────────

    match /users/{userId} {
      allow read: if isAuth();
      allow write: if isOwner(userId);
      // FIX #1: acceptRequest fait un arrayUnion dans le doc d'un AUTRE utilisateur.
      // On autorise l'update du seul champ 'friends' par n'importe quel user connecté.
      allow update: if isOwner(userId) ||
        (isAuth() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends']));

      match /onboarding/{docId} {
        allow read, write: if isOwner(userId);
      }
      match /favorites/{favoriteId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.keys().hasAll(['name', 'createdAt']);
        allow update, delete: if isOwner(userId);
      }
      match /wishlists/{wishlistId} {
        // Lecture : propriétaire + tout user authé (filtrage isPublic côté client)
        allow read: if isAuth();
        allow write: if isOwner(userId);
        match /products/{productId} {
          // Lecture : propriétaire OU wishlist publique
          allow read: if isOwner(userId) ||
            (isAuth() && get(/databases/$(database)/documents/users/$(userId)/wishlists/$(wishlistId)).data.isPublic == true);
          allow write: if isOwner(userId);
        }
      }
      match /people/{personId} {
        allow read, write: if isOwner(userId);
        match /giftLists/{listId} {
          allow read, write: if isOwner(userId);
        }
      }
      // FIX #3: profiles subcollection was missing from rules
      match /profiles/{profileId} {
        allow read, write: if isOwner(userId);
      }
      match /giftProfiles/{profileId} {
        allow read, write: if isOwner(userId);
      }
      match /homeFeeds/{feedId} {
        allow read, write: if isOwner(userId);
      }
    }

    // ── gifts / products ────────────────────────────────────────────────────

    match /gifts/{giftId} {
      allow read: if isAuth();
      allow write: if false;
    }
    match /products/{productId} {
      allow read: if isAuth();
      allow write: if false;
    }

    // ── Favourites (legacy FlutterFlow) ─────────────────────────────────────

    match /Favourites/{docId} {
      allow read, create, update, delete: if isAuth();
    }
    match /favourites/{docId} {
      allow read, create, update, delete: if isAuth();
    }

    // ── chats & messages ────────────────────────────────────────────────────

    match /chats/{chatId} {
      allow read: if isAuth() && request.auth.uid in resource.data.participants;
      allow create: if isAuth() && request.auth.uid in request.resource.data.participants;
      // FIX: allow update for new members being added (joinByToken / addMember)
      allow update: if isAuth() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid in request.resource.data.participants
      );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        // FIX #7: system messages have senderId == 'system', relax the sender check
        allow create: if isAuth()
                   && isChatParticipant(chatId)
                   && (request.resource.data.senderId == request.auth.uid
                       || request.resource.data.get('type', '') == 'system');
        allow update, delete: if isAuth() && resource.data.senderId == request.auth.uid;
      }
    }

    // ── wishlists (root collection) ─────────────────────────────────────────

    match /wishlists/{wishlistId} {
      allow read, write: if isAuth() && resource != null && resource.data.ownerUid == request.auth.uid;
      allow create: if isAuth() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if isAuth() && resource.data.isPublic == true;

      match /products/{productId} {
        allow read: if isAuth();
        allow write: if isAuth() &&
          get(/databases/$(database)/documents/wishlists/$(wishlistId)).data.ownerUid == request.auth.uid;
      }
    }

    // ── friend_requests ─────────────────────────────────────────────────────

    match /friend_requests/{requestId} {
      allow read: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      // FIX: both sender and receiver can update (sender can cancel)
      allow update: if isAuth() && (
        resource.data.toUid == request.auth.uid ||
        resource.data.fromUid == request.auth.uid
      );
      allow delete: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ── handles ─────────────────────────────────────────────────────────────

    match /handles/{handle} {
      allow read: if isAuth();
      allow create: if isAuth() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.uid == request.auth.uid;
    }

    // ── collaborations ──────────────────────────────────────────────────────

    match /collaborations/{collabId} {
      // FIX #2: pendingInvites must also be able to read the doc before joining
      allow read: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        request.auth.uid in resource.data.get('pendingInvites', [])
      );
      allow create: if isAuth() && request.resource.data.ownerId == request.auth.uid;
      // FIX #2: pendingInvites must be allowed to update (joinByToken / addMember)
      allow update: if isAuth() && (
        resource.data.ownerId == request.auth.uid ||
        request.auth.uid in resource.data.members ||
        request.auth.uid in resource.data.get('pendingInvites', [])
      );
      allow delete: if isAuth() && resource.data.ownerId == request.auth.uid;
    }

    // ── collab_invites ──────────────────────────────────────────────────────

    match /collab_invites/{inviteId} {
      allow read: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      allow create: if isAuth() && request.resource.data.fromUid == request.auth.uid;
      allow update: if isAuth() && resource.data.toUid == request.auth.uid;
      allow delete: if isAuth() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ── fallback ─────────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
